{
  "name": "beam-decision-maker-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "BEAM Decision-Maker Intelligence: relationship intelligence for senior decision-makers.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "cp -R .next/static .next/standalone/.next/ && node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "demo:reset": "tsx --env-file-if-exists=.env scripts/demo-reset.ts",
    "db:setup": "tsx --env-file-if-exists=.env scripts/setup.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "5.11.2",
    "htmlparser2": "12.0.0",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
